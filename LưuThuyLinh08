// BÀI 1: SỐ NGUYÊN TỐ
// Hàm kiểm tra số nguyên tố
function isPrime($n) {

    // Số nhỏ hơn 2 không phải số nguyên tố
    if ($n < 2) {
        return false;
    }
    for ($i = 2; $i < $n; $i++) {
        if ($n % $i == 0) {
            return false;
        }
    }
    return true;
}

echo "<h2>Số nguyên tố từ 1 đến 100</h2>";

echo "Các số nguyên tố là: ";

for ($i = 1; $i <= 100; $i++) {

    if (isPrime($i)) {
        echo $i . " ";
    }
}

