// Bài 2: Quản lý sản phẩm
$products = [

    [
        "name" => "Laptop",
        "price" => 15000000,
        "quantity" => 2
    ],

    [
        "name" => "Điện thoại",
        "price" => 8000000,
        "quantity" => 3
    ],

    [
        "name" => "Tai nghe",
        "price" => 500000,
        "quantity" => 5
    ]

];

function totalValue($products) {

    $total = 0;

    foreach ($products as $product) {

        $total = $total + ($product["price"] * $product["quantity"]);
    }

    return $total;
}


echo "<h2>Bài 2: Quản lý sản phẩm</h2>";

foreach ($products as $product) {

    echo "Tên sản phẩm: " . $product["name"] . "<br>";
    echo "Giá: " . $product["price"] . " VNĐ<br>";
    echo "Số lượng: " . $product["quantity"] . "<br>";

    $value = $product["price"] * $product["quantity"];

    echo "Giá trị: " . $value . " VNĐ<br>";

    echo "<hr>";
}
echo "<strong>Tổng giá trị tất cả sản phẩm: "
    . totalValue($products)
    . " VNĐ</strong>";

